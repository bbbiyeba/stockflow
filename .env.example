# Copy to .env (never commit .env). The app and pipeline read these from the environment.

# Config file to use (default: config.yaml at the project root)
# STOCKFLOW_CONFIG=config.yaml

# --- Dashboard access -------------------------------------------------------
# Require sign-in through Streamlit's OIDC login (configure the provider in
# .streamlit/secrets.toml, which is git-ignored). Strongly recommended for real data.
STOCKFLOW_REQUIRE_LOGIN=0
# Comma-separated e-mails allowed to approve / reject transfers (everyone else is a viewer).
STOCKFLOW_APPROVERS=
# Demo only: let an unauthenticated local user record decisions under a typed name.
STOCKFLOW_DEMO_APPROVALS=0
# Hide all dollar amounts in the UI (for screenshots / demos of real data).
STOCKFLOW_MASK_FINANCIALS=0

# --- Logging -------------------------------------------------------------------
STOCKFLOW_LOG_FORMAT=text   # text | json
STOCKFLOW_LOG_LEVEL=INFO

# --- Real data sources (only if you add a database extract step) ----------------
# Never hard-code credentials; read them from the environment or a secrets manager.
# ERP_DSN=
# WMS_DSN=
